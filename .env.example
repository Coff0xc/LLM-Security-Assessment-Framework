# FORGEDAN 环境变量配置
# 复制此文件为 .env 并填入实际值
# 快速体验: 无需配置任何 API Key，使用 mock 模式即可运行
#   forgedan run --quick -g "test" -m mock:test

# ============================================================
# 国际模型
# ============================================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro

# ============================================================
# 国产模型
# ============================================================

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 智谱 (Zhipu/GLM)
ZHIPU_API_KEY=your-zhipu-api-key-here

# 百川 (Baichuan)
BAICHUAN_API_KEY=your-baichuan-api-key-here

# 通义千问 (Qwen/DashScope)
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# 月之暗面 (Moonshot/Kimi)
MOONSHOT_API_KEY=your-moonshot-api-key-here

# 零一万物 (Yi/01.AI)
YI_API_KEY=your-yi-api-key-here

# ============================================================
# 本地模型
# ============================================================

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# vLLM
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=meta-llama/Llama-2-7b-chat-hf

# HuggingFace
HUGGINGFACE_MODEL=meta-llama/Llama-2-7b-chat-hf
HUGGINGFACE_TOKEN=hf_your_token_here

# ============================================================
# 运行配置
# ============================================================

# 数据集路径
ADVBENCH_PATH=./data/advbench.json

# 日志
LOG_LEVEL=INFO
LOG_FILE=./logs/forgedan.log

# 报告
REPORT_DIR=./reports

# ============================================================
# Web 安全配置
# ============================================================

# Flask SECRET_KEY (生产环境必须设置，否则每次启动会随机生成)
SECRET_KEY=your-random-secret-key-here

# FORGEDAN API 认证密钥 (留空则不启用API认证)
FORGEDAN_API_KEY=

# CORS 允许的来源 (多个用逗号分隔)
CORS_ALLOWED_ORIGINS=http://localhost:5173
