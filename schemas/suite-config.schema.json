{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coff0xc.local/forgedan/schemas/suite-config.schema.json",
  "title": "ForgeDAN Suite Config Snapshot",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "model",
    "api_key_env",
    "iterations",
    "population",
    "elite",
    "policy",
    "report_metadata",
    "run_metadata",
    "acceptance_criteria",
    "review_decisions",
    "risk_register_defaults",
    "usage_pricing",
    "source_inventory",
    "scorers",
    "cases"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "api_key_env": { "type": "string", "minLength": 1 },
    "iterations": { "type": "integer", "minimum": 1 },
    "population": { "type": "integer", "minimum": 2 },
    "elite": { "type": "integer", "minimum": 1 },
    "random_seed": { "type": ["integer", "null"], "minimum": 0 },
    "policy": {
      "type": "object",
      "properties": {
        "max_attack_success_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "max_prompt_findings": { "type": ["integer", "null"], "minimum": 0 },
        "max_response_findings": { "type": ["integer", "null"], "minimum": 0 },
        "max_risk_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "required_case_categories": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "required_policy_domains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "required_owasp_llm_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "allowed_mcp_trust_tiers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tool_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_destination_allowlist": { "type": "boolean" },
        "allowed_domains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "blocked_domains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "blocked_actions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "report_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessment_id": { "type": "string" },
        "report_title": { "type": "string" },
        "client": { "type": "string" },
        "authors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reviewers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "classification": { "type": "string" },
        "assessment_start": { "type": ["string", "null"] },
        "assessment_end": { "type": ["string", "null"] }
      }
    },
    "run_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": { "type": "string" },
        "started_at": { "type": "string" },
        "completed_at": { "type": "string" },
        "generated_at": { "type": "string" },
        "case_id_prefix": { "type": "string" },
        "case_started_at": { "type": "string" },
        "case_completed_at": { "type": "string" },
        "duration_seconds": { "type": ["number", "null"], "minimum": 0 },
        "case_duration_seconds": { "type": ["number", "null"], "minimum": 0 },
        "latency_ms": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["accepted_risk", "failed", "passed", "review_required"]
          },
          "owner": { "type": "string" },
          "evidence": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "review_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": [
              "accepted_risk",
              "approved",
              "mitigation_required",
              "rejected",
              "review_required"
            ]
          },
          "owner": { "type": "string" },
          "related_policy_violations": {
            "type": "array",
            "items": { "type": "string" }
          },
          "related_cases": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "risk_register_defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["open", "accepted", "mitigated", "false_positive"]
        },
        "due_date": { "type": "string" }
      }
    },
    "usage_pricing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_usd_per_1k_tokens": { "type": ["number", "null"], "minimum": 0 },
        "completion_usd_per_1k_tokens": { "type": ["number", "null"], "minimum": 0 },
        "source": { "type": "string" }
      }
    },
    "usage_pricing_file": { "type": ["string", "null"] },
    "mcp_trust_policy_file": { "type": ["string", "null"] },
    "mcp_trust_tiers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["score"],
        "properties": {
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "rationale": { "type": "string" }
        }
      }
    },
    "response_cache_file": { "type": ["string", "null"] },
    "cases_file": { "type": ["string", "null"] },
    "mcp_manifest_file": { "type": ["string", "null"] },
    "mcp_manifest_case_category": { "type": "string", "minLength": 1 },
    "model_artifact_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "model_artifact_case_category": { "type": "string", "minLength": 1 },
    "model_serialization_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_type",
          "path",
          "size_bytes",
          "sha256",
          "generated_case_count"
        ],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": ["cases_file", "mcp_manifest", "mcp_trust_policy_file", "model_artifact", "model_serialization_file", "usage_pricing_file"]
          },
          "path": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "generated_case_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "scorers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "scorer_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "text"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["contains"] },
          "text": { "type": "string", "minLength": 1 },
          "case_sensitive": { "type": "boolean" }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "goal"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "metadata": { "type": "object" },
          "seed_template": { "type": "string", "minLength": 1 },
          "target_output": { "type": "string" },
          "iterations": { "type": ["integer", "null"], "minimum": 1 },
          "population": { "type": ["integer", "null"], "minimum": 2 },
          "elite": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    }
  }
}
